[
  {
    "id": "s1a",
    "text": "ಈ ರಸ್ತೆಯ ಪ್ರತಿಯೊಂದು ಅಂದವಾದ ಅಂಗಡಿಗೂ ಒಂದು ಕಥೆ ಇದೆ."
  },
  {
    "id": "s1b",
    "text": "ಮೂಲೆಲ್ಲಿರುವ ಬಟ್ಟೆ ಅಂಗಡಿ. ಮೂರು ಮನೆ ಮುಂದೆ ದರ್ಜಿ."
  },
  {
    "id": "s2a",
    "text": "ಈಗಲೇ, ನಿಮ್ಮ ಹತ್ತಿರವೇ ಯಾರೋ ನೀವು ಮಾರುವುದನ್ನೇ ಹುಡುಕುತ್ತಿದ್ದಾರೆ."
  },
  {
    "id": "s2b",
    "text": "ಅವರು ಫೋನ್ ತೆರೆದಾಗ, ನೀವು ಅಲ್ಲಿ ಇಲ್ಲ."
  },
  {
    "id": "s4a",
    "text": "ಹಾಗಾಗಿ ಮಾರಾಟ ಬೇರೆಯವರ ಪಾಲಾಗುತ್ತದೆ."
  },
  {
    "id": "s4b",
    "text": "ಪ್ರತಿ ಬಾರಿಯೂ."
  },
  {
    "id": "s5a",
    "text": "ನಾವು ಸರಳ: ಯೋಜನೆ, ನಿರ್ಮಾಣ, ಬಿಡುಗಡೆ."
  },
  {
    "id": "s6a",
    "text": "ನಿಮಗೆ ಸಿಗುವುದು ಒಂದು ಲ್ಯಾಂಡಿಂಗ್ ಪೇಜ್."
  },
  {
    "id": "s6b",
    "text": "ನಿಮ್ಮ ಫೋಟೋಗಳು, ನಿಮ್ಮ ಸೇವೆಗಳು, ಮತ್ತು ಒಂದು ಟ್ಯಾಪ್‌ನಲ್ಲಿ ಕರೆ."
  },
  {
    "id": "s7a",
    "text": "ಬುಕಿಂಗ್ ವ್ಯವಸ್ಥೆ, ಕರೆ ಮಾಡುವ ಬದಲು ಸಮಯ ಆಯ್ಕೆ ಮಾಡಲು."
  },
  {
    "id": "s8a",
    "text": "ಪೇಮೆಂಟ್ ಗೇಟ್‌ವೇ, ಬರುವ ಮುನ್ನವೇ ಹಣ ಪಾವತಿಸಲು."
  },
  {
    "id": "s9a",
    "text": "ಡ್ಯಾಶ್‌ಬೋರ್ಡ್‌ನಲ್ಲಿ ಪ್ರತಿ ಬುಕಿಂಗ್, ಪ್ರತಿ ರೂಪಾಯಿ."
  },
  {
    "id": "s10a",
    "text": "ಮೂರು ಯೋಜನೆಗಳು. ತಿಂಗಳಿಗೆ ಐನೂರ ತೊಂಬತ್ತೊಂಬತ್ತರಿಂದ ಎರಡು ಸಾವಿರದ ನೂರ ತೊಂಬತ್ತೊಂಬತ್ತು ರೂಪಾಯಿ."
  },
  {
    "id": "s10b",
    "text": "ಬುಕಿಂಗ್, ಪೇಮೆಂಟ್, ಡ್ಯಾಶ್‌ಬೋರ್ಡ್ ಪ್ರೀಮಿಯಂನಲ್ಲಿ."
  },
  {
    "id": "s11a",
    "text": "ಪ್ರತಿ ಯೋಜನೆಗೆ ಹೋಸ್ಟಿಂಗ್, ನಿರ್ವಹಣೆ, ಡೊಮೇನ್."
  },
  {
    "id": "s11b",
    "text": "ವಾರ್ಷಿಕವಾಗಿ ಪಾವತಿಸಿ, ಹತ್ತು ಶೇಕಡಾ ಉಳಿಸಿ."
  },
  {
    "id": "s12a",
    "text": "ವೆಬ್ರಿವೋ."
  },
  {
    "id": "s12b",
    "text": "ಊರನ್ನು ಮನೆ ಎಂಬಂತೆ ಮಾಡುವ ವ್ಯಾಪಾರಗಳಿಗಾಗಿ."
  },
  {
    "id": "s12c",
    "text": "ನಿಮ್ಮನ್ನು ಹುಡುಕಿಸಿಕೊಳ್ಳೋಣ."
  }
]
